# ── API Gateway ─────────────────────────────────────────────────────────────
API_GATEWAY_PORT=8000

# ── Microservice URLs (Docker internal) ─────────────────────────────────────
EVENT_SERVICE_URL=http://event-service:8001
ANALYTICS_SERVICE_URL=http://analytics-service:8002
ALERT_SERVICE_URL=http://alert-service:8003
DASHBOARD_SERVICE_URL=http://dashboard-service:8004

# ── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_PORT=80

# ── Firebase ────────────────────────────────────────────────────────────────
# 1. Ir a Firebase Console → Ajustes → Cuentas de servicio
# 2. Generar nueva clave privada → guardar como serviceAccount.json
# 3. Colocar el archivo en la raíz del proyecto (junto a docker-compose.yml)
# 4. Los microservicios leerán datos desde Firestore automáticamente
FIREBASE_SERVICE_ACCOUNT=./serviceAccount.json
